# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://nuloafrica.vercel.app,https://nuloafrica.com,https://www.nuloafrica.com

# Paystack Configuration -- DEPRECATED for the 2026 hackathon
# Hackathon uses Nomba virtual accounts (see NOMBA_* below).
# These keys are kept as optional so any local env that still
# references them will continue to parse. The Paystack code path
# in the backend is a 410 Gone shim (app/routes/payments.py).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─────────────────────────────────────────────────────────────
# PROPFLOW AI AGENT (Qwen Cloud Hackathon)
# ─────────────────────────────────────────────────────────────

# Qwen API — Alibaba Cloud DashScope (openai-compatible endpoint)
# Get your key at: https://dashscope-intl.aliyuncs.com
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_FALLBACK_MODEL=qwen-turbo
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=1000

# Mem0 Persistent Memory
# MEM0_MODE=local  → in-process Chroma vector store (no extra account)
# MEM0_MODE=cloud  → mem0.ai cloud (requires MEM0_API_KEY)
MEM0_MODE=local
MEM0_API_KEY=
MEM0_LOCAL_PATH=.mem0_store

# Alibaba Cloud OSS — Agreement PDF Storage
# MANDATORY hackathon proof file: server/app/propflow/services/oss_client.py
# Create bucket "nuloafrica-agreements" at: https://oss.console.aliyun.com
ALIBABA_CLOUD_ACCESS_KEY_ID=your-alibaba-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-alibaba-access-key-secret
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET_NAME=nuloafrica-agreements
OSS_REGION=ap-southeast-1

# PropFlow Feature Flags (set to False to disable individual services)
ENABLE_PROPFLOW=True
ENABLE_MEM0_MEMORY=True
ENABLE_OSS_STORAGE=True
ENABLE_NOMBA_INTEGRATION=True
ENABLE_LANDLORD_APPROVAL_INTERRUPT=True
ENABLE_TENANT_SIGN_INTERRUPT=True

# PropFlow Intent Confidence Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.7
PROPERTY_MATCH_THRESHOLD=0.8
