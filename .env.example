# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://nuloafrica.vercel.app,https://nuloafrica.com,https://www.nuloafrica.com

# ─────────────────────────────────────────────────────────────
# PAYMENT PROVIDER SELECTION (2026-08-17)
# Controls which provider is used for tenant-facing payment COLLECTION
# (virtual-account / NUBAN provisioning). Switch by changing this ONE line:
#   nomba    - Nomba virtual accounts (default)
#   paystack - Paystack dedicated virtual accounts (test mode)
#   mock     - Offline / tests (always returns a mock NUBAN)
# NOTE: Disbursement (landlord payout) ALWAYS stays on Nomba regardless of
# this setting, since Paystack has no escrow/disbursement equivalent.
PAYMENT_PROVIDER=nomba

# Paystack Configuration (used when PAYMENT_PROVIDER=paystack)
# Dedicated-virtual-account API: https://paystack.com/docs/api/dedicated-virtual-account/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_URL=https://api.paystack.co

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─────────────────────────────────────────────────────────────
# PROPFLOW AI AGENT (Qwen Cloud Hackathon)

# LLM Provider Selection (Phase B) — switch models by changing this ONE line:
#   qwen   -> Alibaba DashScope (QWEN_* vars below)   [default]
#   groq   -> Groq Cloud llama family (GROQ_API_KEY + GROQ_* vars)
#   openai -> OpenAI (OPENAI_API_KEY + OPENAI_* vars)
#   mock   -> offline; every call falls to deterministic mocks
LLM_PROVIDER=qwen
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────

# Qwen API — Alibaba Cloud DashScope (openai-compatible endpoint)
# Get your key at: https://dashscope-intl.aliyuncs.com
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_FALLBACK_MODEL=qwen-turbo
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=1000

# Mem0 Persistent Memory
# MEM0_MODE=local  → in-process Chroma vector store (no extra account)
# MEM0_MODE=cloud  → mem0.ai cloud (requires MEM0_API_KEY)
MEM0_MODE=local
MEM0_API_KEY=
MEM0_LOCAL_PATH=.mem0_store

# Supabase Storage — Agreement PDF Storage
# Draft agreement PDFs are uploaded to the existing public "ownership-docs"
# bucket via the same Supabase service-role client (no extra credentials).
AGREEMENT_STORAGE_BUCKET=ownership-docs

# PropFlow Feature Flags (set to False to disable individual services)
ENABLE_PROPFLOW=True
ENABLE_MEM0_MEMORY=True
ENABLE_NOMBA_INTEGRATION=True
ENABLE_LANDLORD_APPROVAL_INTERRUPT=True
ENABLE_TENANT_SIGN_INTERRUPT=True

# PropFlow Intent Confidence Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.7
PROPERTY_MATCH_THRESHOLD=0.8
